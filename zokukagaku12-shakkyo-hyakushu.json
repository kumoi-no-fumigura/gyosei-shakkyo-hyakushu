   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ゑるやいかによるいもがらによぶ三世の佛比御名ハ我名んとい",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "時しあれバ松も新となりぬなりなにを常磐の物とさだめむ",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "紅葉みし秋いきのふの夢のまに世いふりかはる村時雨かな",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "何事もきのふの夢ときゝながらなほさめうねるわら心かな",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "衣だにふたつときゝし言の葉の露にぬらさぬ袖なかるらむ",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "我道にいらむとならバ梓弓そるぞはじめのをしへなりける",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よのうさをあはれ之れぶの摺衣きてあそハ見め道比奧をも",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "進みゆくこゝろの駒いうつ鞭のかげも月毛も及ばざりけり",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "高野山あけのとぼそい去づかおて音もきこえず春雨のふる",
   "kana": "",
   "speaker": "",
   "page": 61,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "めしひたる龜も浮木にあふも比をいつまで沈む我身なるらむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "うへもなき玉の臺もおくつゆの𛁈ばしけぬまの光なるらむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あともなき風にあらそふ心より迷のなみやたちさわぐらむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "梢ふも心とまらぬもみぢ葉をいとひかねたる人にみせばや",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "御名をのみきくの下露いつのまに深き悟のふちとなりけむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "さめぬれがありとも見えず手枕の夢の通路なにたどりけむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ちらぬ里かげ傾かぬ山の端につきと花とをまかせたらなむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "こけむせる岩がね枕かをるなり春いうれしき花のゑたぶし",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "西へゆく道ひと筋にまかせてんなみも炎もあとに見なして",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "天が下みなわが物となれるおも猶ものたらぬ心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "いが栗のとげ〓〓しさのみ比末や落ていかなる火に燒かるらむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "はら黑きひと比心やぬば玉のやみ路をたどる種となりけむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "三十あまりみつの浦船波たちてさす棹いかに隙なかるらむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "はてもなく思ひあがりし心よりあそらと迄の各い負あけむ",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "袖ぬれし水際のなみも音かへて炎ばかりぞもえわたるなる",
   "kana": "",
   "speaker": "",
   "page": 62,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "うれしくも人と生れて御佛おさとり比道もこれよりぞいる",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "我も又をしとこそ思へをしと思ふいのちハ同じ命ならずや",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "まねくとも尾花グそでい心せよあらぬ荒野に道やまよはむ",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "呼子鳥よべがこたふる山彥のそれもまこと比聲ふやいある",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "通まぼろしの夢路をからで過し世を現となして見るが珍らし",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "あみだぶと聲あいたてよ山びあもよべが答ふる習ある世に",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "少林の雪に玄たヾるくれなゐふ染めよ心のいろあさくとも",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "心なき嵐あもあるろつとおとて手折し花いちりにけらしも",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "たちかへる道まどふらむ霜さゆる枯野のはらに狐なくなり",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "ふる雪も及ばぬまでに花ぞちるあなおもしるの春の山かぜ",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "遙あも我もきゝしクわしの山むかしのまヽの案のはるかぜ",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "さら〓〓と音いたてゝも蘆原の末葉に風いとまらさりけり",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "かれやらぬおのグ古根の生いでて今年も騒ぐ蘆比みだれ葉",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "春霞けさうら〓〓とたちいでぬ初音ほどこせ門のうぐひす",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "あれまさる心の駒いいくたびも鞭うちてこそ進むとを玄れ",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "塵比世を木末となして木傳ふいなにの心のやまざるぞあれ",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "我のりも山のは近くなりぬらしかもりにのみぞ有明のつき",
   "kana": "",
   "speaker": "",
   "page": 63,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "此世のみ世とな思ひそ後のよも其比ちの世も同し世なるぞ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "虎とみて石おも征箭いたつか弓ひきおゆるべそ摩訶菩提心",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "さだめなき風にまかせてちる花を花とばかりも思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "墨ぞめのくらまの山のやま櫻ゆふべい雲とあやしまれつゝ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "ぬぎかふるわづらひもなし夏きても苦の衣いたゞ一重おて",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "もとよりも濁に玄まぬ蓮葉のひらくや花のさとりなるらむ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "事もあらで今年も秋になりひさおなりさグりたる身ぞ安をなる",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "あまりおもみつれバ欠ることわりを忘れ顔なる秋比夜の月",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "かつうらみかつ招きつゝ葛尾花同じ夢野あたちさわぐらむ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "わグとしも八十うぢ川の網代守玄ぬるひをまつ翁なりけり",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "花とめで月とながめし春秋のはていかしらの雪ぞつもれる",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "なす事もあらで今年もくれはどりあやまり勝に過しつる哉",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "こゝをしもさとりの峯とおもひしい迷にくだる始なりけり",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "おきふしを風にまかせてすなほなる竹を心比友がきおせよ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "比りの舟さもといすれと角田川わたし守ふい及ばさりけり",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "世中いかりほの垣の蝸生つのさしいだすひまあぞありける",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "習はじな澤邊此蟹北横ゐせみゆけバゆかるヽ道いありとも",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "あれバ又なきを數へて世の人のたれりと思ふ時やながらむ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "長き夜の旅寐を覺すくだかけいにしに心をかけろとぞなく",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "くるずヽのたま〓〓えたる人の身に數ふる程の功德ともがな",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "あふがれていつまで世ゐいふる扇やがて骨ともなり果る身を",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "春といひ秋とくらして花紅葉みしい夕べの夢おぞありける",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "さやかおも心の月い見ゆべきをはれぬやむねの烟なるらむ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "うらみなき秋を昔にふきかへせ眞葛グはらをわたる朝かぜ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "隱れがさかづくと迄いあらねども今日より人に見えじとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
